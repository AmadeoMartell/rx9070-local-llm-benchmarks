{
 "exe": "build-mmq/strata",
 "args": [
  "--pack",
  "packs/gyro-m",
  "--native",
  "~/models/gyro/Qwen3.8-Flash-Next-Gyro-M-TQ2_0.gguf",
  "--expert-profile",
  "data/expert-profile.bin",
  "--expert-cache",
  "auto",
  "--prefill",
  "2048",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--mtp",
  "mtp/rt",
  "--max-context",
  "196608",
  "--kv",
  "int8",
  "--resident-experts",
  "--prompt-cache-spread",
  "--prompt-cache",
  "2",
  "--mtp-draft-vocab",
  "data/draft_vocab_cyrillic.bin",
  "--conversation-cache-mib",
  "0"
 ],
 "cwd": ".",
